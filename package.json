{
  "name": "javaabu-dynamic-menubuilder-assets",
  "private": true,
  "description": "Build and test tooling for javaabu/dynamic-menubuilder's JavaScript: the menu builder, the Menu component and the Inertia pages in resources/js, imported by apps as @javaabu/dynamic-menubuilder through javaabu/manifest, and the Blade builder script built into dist/.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "build:check": "vite build && test -z \"$(git status --porcelain -- dist)\" || (git status --short -- dist && echo \"dist/ is out of date: run pnpm build and commit it.\" && exit 1)"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inertiajs/react": "^2.3.29",
    "@javaabu/forms": "github:Javaabu/react-forms#next-gen",
    "@javaabu/i18n": "github:Javaabu/i18n#build-on-git-install",
    "@javaabu/onu": "^0.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@javaabu/forms",
      "@javaabu/i18n"
    ]
  }
}
